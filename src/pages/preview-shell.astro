---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout
  title="__PREVIEW_TITLE__"
  description="__PREVIEW_DESCRIPTION__"
  sectionLabel="Journal / microCMSプレビュー"
>
  <p class="preview-banner" role="note">microCMS下書きの表示確認（本番記事ではありません）</p>
  <p class="post-meta">
    <span class="post-date">__PREVIEW_DATE__</span>
    <span class="post-theme is-plain">__PREVIEW_THEME_LABEL__</span>
  </p>
  __PREVIEW_EYECATCH_HTML__
  <div class="post-body">__PREVIEW_CONTENT_HTML__</div>
</PageLayout>
