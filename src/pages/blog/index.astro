---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { BLOG_THEME_IDS, themeLabel } from '../../lib/blogThemes';
import { isVisiblePost } from '../../lib/blogVisibility';
import { resolveContentSourcePriority, selectBlogSource } from '../../lib/blogSource';
import { getResolvedPublishedArticles } from '../../lib/microcms';

const priority = resolveContentSourcePriority(import.meta.env.BLOG_SOURCE_PRIORITY);

// priority='markdown'(移行・照合中)ではmicroCMSを一切参照しない。
const markdownPosts =
  priority === 'markdown'
    ? (await getCollection('blog')).filter(isVisiblePost).map((post) => ({
        slug: post.data.slug ?? post.slug,
        title: post.data.title,
        description: post.data.description,
        pubDate: post.data.pubDate,
        theme: post.data.theme,
        imageUrl: post.data.image,
      }))
    : [];

// priority='microcms'(移行完了後)ではmicroCMSだけを完全な正本として扱う。
// 取得失敗時はここで例外を投げてビルドを失敗させ、Cloudflare上の直前の正常なデプロイを維持する
// (Markdown版へフォールバックしない。公開終了・未移行の記事を復活させないため)。
if (priority === 'microcms' && (!import.meta.env.MICROCMS_SERVICE_DOMAIN || !import.meta.env.MICROCMS_API_KEY)) {
  throw new Error(
    'BLOG_SOURCE_PRIORITY=microcmsですが、MICROCMS_SERVICE_DOMAIN/MICROCMS_API_KEYが未設定です。ビルドを中止します。',
  );
}

const microCmsPosts =
  priority === 'microcms'
    ? (
        await getResolvedPublishedArticles({
          serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN ?? '',
          apiKey: import.meta.env.MICROCMS_API_KEY ?? '',
        })
      ).map((post) => ({
        slug: post.slug,
        title: post.title,
        description: post.description,
        pubDate: post.pubDate,
        theme: post.theme,
        imageUrl: post.eyecatch?.url,
      }))
    : [];

const posts = selectBlogSource(markdownPosts, microCmsPosts, priority).sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<PageLayout
  title="香りとセルフケアの読みもの"
  description="嗅覚反応分析、IMチェック、精油、季節のセルフケア、ブレンドレシピについて少しずつ読めるページです。"
  sectionLabel="Journal"
>
  <nav class="theme-nav" aria-label="読みもののテーマ">
    <a class="theme-nav-link is-current" href="/blog/" aria-current="page">すべて</a>
    {
      BLOG_THEME_IDS.map((theme) => (
        <a class="theme-nav-link" href={`/blog/theme/${theme}/`}>
          {themeLabel(theme)}
        </a>
      ))
    }
  </nav>

  <div class="post-list">
    {
      posts.map((post) => (
        <article class="post-card">
          {post.imageUrl && (
            <a class="post-card-image" href={`/blog/${post.slug}/`} aria-label={`${post.title}を読む`}>
              <img src={post.imageUrl} alt="" />
            </a>
          )}
          <p class="post-meta">
            <span class="post-date">
              {post.pubDate.toLocaleDateString('ja-JP', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </span>
            {post.theme && (
              <a class="post-theme" href={`/blog/theme/${post.theme}/`}>
                {themeLabel(post.theme)}
              </a>
            )}
          </p>
          <h2>
            <a href={`/blog/${post.slug}/`}>{post.title}</a>
          </h2>
          <p>{post.description}</p>
          <a class="text-link" href={`/blog/${post.slug}/`}>読む</a>
        </article>
      ))
    }
  </div>
</PageLayout>
