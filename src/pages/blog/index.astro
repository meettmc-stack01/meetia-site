---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { BLOG_THEME_IDS, themeLabel } from '../../lib/blogThemes';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<PageLayout
  title="香りとセルフケアの読みもの"
  description="嗅覚反応分析、IMチェック、精油、季節のセルフケア、ブレンドレシピについて少しずつ読めるページです。"
  sectionLabel="Journal"
>
  <p>
    嗅覚反応分析やIMチェック、精油のこと、季節のセルフケア、ブレンドレシピなど、香りを暮らしに活かすための読みものをまとめています。
  </p>

  <nav class="theme-nav" aria-label="読みもののテーマ">
    <a class="theme-nav-link is-current" href="/blog/" aria-current="page">すべて</a>
    {
      BLOG_THEME_IDS.map((theme) => (
        <a class="theme-nav-link" href={`/blog/theme/${theme}/`}>
          {themeLabel(theme)}
        </a>
      ))
    }
  </nav>

  <div class="post-list">
    {
      posts.map((post) => (
        <article class="post-card">
          {post.data.image && (
            <a class="post-card-image" href={`/blog/${post.data.slug ?? post.slug}/`} aria-label={`${post.data.title}を読む`}>
              <img src={post.data.image} alt="" />
            </a>
          )}
          <p class="post-meta">
            <span class="post-date">
              {post.data.pubDate.toLocaleDateString('ja-JP', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </span>
            {post.data.theme && (
              <a class="post-theme" href={`/blog/theme/${post.data.theme}/`}>
                {themeLabel(post.data.theme)}
              </a>
            )}
          </p>
          <h2>
            <a href={`/blog/${post.data.slug ?? post.slug}/`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
          <a class="text-link" href={`/blog/${post.data.slug ?? post.slug}/`}>読む</a>
        </article>
      ))
    }
  </div>
</PageLayout>
