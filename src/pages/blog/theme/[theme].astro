---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import {
  BLOG_THEME_IDS,
  isBlogTheme,
  themeLabel,
  type BlogTheme,
} from '../../../lib/blogThemes';
import { isVisiblePost } from '../../../lib/blogVisibility';
import { resolveContentSourcePriority, selectBlogSource } from '../../../lib/blogSource';
import { getResolvedPublishedArticles } from '../../../lib/microcms';

export function getStaticPaths() {
  return BLOG_THEME_IDS.map((theme) => ({
    params: { theme },
  }));
}

const { theme: themeParam } = Astro.params;

if (!themeParam || !isBlogTheme(themeParam)) {
  throw new Error(`Unknown blog theme: ${themeParam}`);
}

const theme = themeParam as BlogTheme;
const label = themeLabel(theme);

const priority = resolveContentSourcePriority(import.meta.env.BLOG_SOURCE_PRIORITY);

// priority='markdown'(移行・照合中)ではmicroCMSを一切参照しない。
const markdownPosts =
  priority === 'markdown'
    ? (await getCollection('blog'))
        .filter((post) => isVisiblePost(post) && post.data.theme === theme)
        .map((post) => ({
          slug: post.data.slug ?? post.slug,
          title: post.data.title,
          description: post.data.description,
          pubDate: post.data.pubDate,
          imageUrl: post.data.image,
        }))
    : [];

// priority='microcms'(移行完了後)ではmicroCMSだけを完全な正本として扱う。
// 取得失敗時はここで例外を投げてビルドを失敗させ、Cloudflare上の直前の正常なデプロイを維持する
// (Markdown版へフォールバックしない。公開終了・未移行の記事を復活させないため)。
if (priority === 'microcms' && (!import.meta.env.MICROCMS_SERVICE_DOMAIN || !import.meta.env.MICROCMS_API_KEY)) {
  throw new Error(
    'BLOG_SOURCE_PRIORITY=microcmsですが、MICROCMS_SERVICE_DOMAIN/MICROCMS_API_KEYが未設定です。ビルドを中止します。',
  );
}

const microCmsPosts =
  priority === 'microcms'
    ? (
        await getResolvedPublishedArticles({
          serviceDomain: import.meta.env.MICROCMS_SERVICE_DOMAIN ?? '',
          apiKey: import.meta.env.MICROCMS_API_KEY ?? '',
        })
      )
        .filter((post) => post.theme === theme)
        .map((post) => ({
          slug: post.slug,
          title: post.title,
          description: post.description,
          pubDate: post.pubDate,
          imageUrl: post.eyecatch?.url,
        }))
    : [];

const posts = selectBlogSource(markdownPosts, microCmsPosts, priority).sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf(),
);
---

<PageLayout
  title={`${label}の読みもの`}
  description={`MeetiAの読みもの「${label}」の記事一覧です。`}
  sectionLabel="Journal"
>
  <p>
    「{label}」に関する読みものです。ほかのテーマも、下のリンクから選べます。
  </p>

  <nav class="theme-nav" aria-label="読みもののテーマ">
    <a class="theme-nav-link" href="/blog/">すべて</a>
    {
      BLOG_THEME_IDS.map((item) => (
        <a
          class:list={['theme-nav-link', { 'is-current': item === theme }]}
          href={`/blog/theme/${item}/`}
          aria-current={item === theme ? 'page' : undefined}
        >
          {themeLabel(item)}
        </a>
      ))
    }
  </nav>

  {
    posts.length === 0 ? (
      <p class="theme-empty">このテーマの記事は、これから少しずつ増やしていきます。</p>
    ) : (
      <div class="post-list">
        {posts.map((post) => (
          <article class="post-card">
            {post.imageUrl && (
              <a
                class="post-card-image"
                href={`/blog/${post.slug}/`}
                aria-label={`${post.title}を読む`}
              >
                <img src={post.imageUrl} alt="" />
              </a>
            )}
            <p class="post-meta">
              <span class="post-date">
                {post.pubDate.toLocaleDateString('ja-JP', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
              <span class="post-theme is-plain">{label}</span>
            </p>
            <h2>
              <a href={`/blog/${post.slug}/`}>{post.title}</a>
            </h2>
            <p>{post.description}</p>
            <a class="text-link" href={`/blog/${post.slug}/`}>読む</a>
          </article>
        ))}
      </div>
    )
  }
</PageLayout>
